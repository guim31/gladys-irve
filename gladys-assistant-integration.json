          "value": "50",
          "label": {
            "en": "50 kW",
            "fr": "50 kW",
            "de": "50 kW",
            "es": "50 kW"
          }
        },
        {
          "value": "150",
          "label": {
            "en": "150 kW",
            "fr": "150 kW",
            "de": "150 kW",
            "es": "150 kW"
          }
        }
      ]
    },
