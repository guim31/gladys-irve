    {
      "key": "status",
      "label": {
        "en": "Status",
        "fr": "État",
        "de": "Status",
        "es": "Estado"
      },
      "description": {
        "en": "Position, stations found, stations with live data, last reading and errors.",
        "fr": "Position, stations trouvées, stations avec données en direct, dernière lecture et erreurs.",
        "de": "Position, gefundene Stationen, Stationen mit Live-Daten, letzte Abfrage und Fehler.",
        "es": "Posición, estaciones encontradas, estaciones con datos en directo, última lectura y errores."
      },
      "timeout_seconds": 30,
      "fields": []
    },
    {
      "key": "search",
      "label": {
        "en": "Find a station",
        "fr": "Chercher une station",
        "de": "Station suchen",
        "es": "Buscar una estación"
      },
      "description": {
        "en": "Lists the stations whose address contains a text, with the id to copy in \"Other stations\".",
        "fr": "Liste les stations dont l'adresse contient un texte, avec l'identifiant à copier dans « Autres stations ».",
        "de": "Listet die Stationen, deren Adresse einen Text enthält, mit der ID zum Kopieren in „Weitere Stationen“.",
        "es": "Muestra las estaciones cuya dirección contiene un texto, con el identificador para copiar en «Otras estaciones»."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "query",
          "type": "string",
          "required": true,
          "label": {
            "en": "Town or street",
            "fr": "Commune ou rue",
            "de": "Ort oder Straße",
            "es": "Municipio o calle"
          },
          "placeholder": {
            "en": "e.g. Blagnac",
            "fr": "ex. Blagnac",
            "de": "z. B. Blagnac",
            "es": "p. ej. Blagnac"
          }
        }
      ]
    }
