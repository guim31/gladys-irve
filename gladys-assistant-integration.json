          "value": "ef",
          "label": {
            "en": "Domestic socket (E/F)",
            "fr": "Prise domestique (E/F)",
            "de": "Haushaltssteckdose (E/F)",
            "es": "Enchufe doméstico (E/F)"
          }
        }
      ]
    },
    {
      "key": "stations",
      "type": "string",
      "required": false,
      "label": {
        "en": "Other stations (ids)",
        "fr": "Autres stations (identifiants)",
        "de": "Weitere Stationen (IDs)",
        "es": "Otras estaciones (identificadores)"
      },
      "description": {
        "en": "Station ids, separated by commas, wherever they are: use the \"Find a station\" action below.",
        "fr": "Identifiants de stations, séparés par des virgules, où qu'elles soient : action « Chercher une station » ci-dessous.",
        "de": "Stations-IDs, durch Kommas getrennt, egal wo: nutze unten die Aktion „Station suchen“.",
        "es": "Identificadores de estaciones, separados por comas, estén donde estén: use la acción «Buscar una estación» abajo."
      },
      "placeholder": {
        "en": "e.g. FRTLSP31555001",
        "fr": "ex. FRTLSP31555001",
        "de": "z. B. FRTLSP31555001",
        "es": "p. ej. FRTLSP31555001"
      }
    },
    {
      "key": "refresh_interval",
      "type": "select",
      "default": "600",
      "label": {
        "en": "Refresh",
        "fr": "Rafraîchissement",
        "de": "Aktualisierung",
        "es": "Actualización"
      },
      "options": [
        {
          "value": "300",
          "label": {
            "en": "Every 5 minutes",
            "fr": "Toutes les 5 minutes",
            "de": "Alle 5 Minuten",
            "es": "Cada 5 minutos"
          }
        },
        {
          "value": "600",
          "label": {
            "en": "Every 10 minutes",
            "fr": "Toutes les 10 minutes",
            "de": "Alle 10 Minuten",
            "es": "Cada 10 minutos"
