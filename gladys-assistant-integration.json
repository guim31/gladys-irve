{
  "manifest_version": 1,
  "type": "device",
  "name": "Bornes de recharge (IRVE)",
  "description": {
    "en": "Live availability of public EV charging stations near you in France (national open data, IRVE).",
    "fr": "Disponibilité en direct des bornes de recharge publiques autour de chez vous (open data IRVE).",
    "de": "Live-Verfügbarkeit öffentlicher Ladestationen in deiner Nähe in Frankreich (Open Data IRVE).",
    "es": "Disponibilidad en directo de los puntos de recarga públicos cerca de usted en Francia (IRVE)."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-irve:1.0.1",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-irve/main/cover.png",
  "categories": ["energy", "services"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "The public charging stations around your house (or the ones you list) that publish their live state appear in the Discover tab. Add the ones you use to Gladys. No account, no key.",
        "fr": "Les bornes publiques autour de votre maison (ou celles que vous listez) qui publient leur état en direct apparaissent dans l'onglet Découverte. Ajoutez à Gladys celles que vous utilisez. Sans compte ni clé.",
        "de": "Die öffentlichen Ladestationen um dein Zuhause (oder die, die du auflistest), die ihren Zustand live veröffentlichen, erscheinen im Tab „Entdecken“. Füge die, die du nutzt, zu Gladys hinzu. Kein Konto, kein Schlüssel.",
        "es": "Las estaciones públicas alrededor de su casa (o las que usted indique) que publican su estado en directo aparecen en la pestaña Descubrir. Añada a Gladys las que utiliza. Sin cuenta ni clave."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-irve/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide de configuration",
            "de": "Einrichtungsanleitung",
            "es": "Guía de configuración"
          }
        }
      ]
    },
    {
      "key": "house",
      "type": "select",
      "source": "houses",
      "required": false,
      "label": {
        "en": "House",
        "fr": "Maison",
        "de": "Zuhause",
        "es": "Vivienda"
      },
      "description": {
        "en": "Center of the search. Empty: the first located house.",
        "fr": "Centre de la recherche. Vide : la première maison localisée.",
        "de": "Mittelpunkt der Suche. Leer: das erste Zuhause mit Standort.",
        "es": "Centro de la búsqueda. Vacío: la primera vivienda ubicada."
      }
    },
    {
      "key": "position",
      "type": "string",
      "required": false,
      "label": {
        "en": "Other position (optional)",
        "fr": "Autre position (facultatif)",
        "de": "Andere Position (optional)",
        "es": "Otra posición (opcional)"
      },
      "description": {
        "en": "Latitude, longitude: replaces the house (your workplace, for example).",
        "fr": "Latitude, longitude : remplace la maison (votre lieu de travail, par exemple).",
        "de": "Breitengrad, Längengrad: ersetzt das Zuhause (zum Beispiel deine Arbeit).",
        "es": "Latitud, longitud: sustituye a la vivienda (su lugar de trabajo, por ejemplo)."
      },
      "placeholder": {
        "en": "e.g. 43.6045, 1.4440",
        "fr": "ex. 43.6045, 1.4440",
        "de": "z. B. 43.6045, 1.4440",
        "es": "p. ej. 43.6045, 1.4440"
      }
    },
    {
      "key": "radius_km",
      "type": "select",
      "default": "5",
      "label": {
        "en": "Radius",
        "fr": "Rayon",
        "de": "Radius",
        "es": "Radio"
