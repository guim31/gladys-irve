        {
          "value": "10",
          "label": {
            "en": "10 km",
            "fr": "10 km",
            "de": "10 km",
            "es": "10 km"
          }
        },
        {
          "value": "20",
          "label": {
            "en": "20 km",
            "fr": "20 km",
            "de": "20 km",
            "es": "20 km"
          }
        }
      ]
    },
